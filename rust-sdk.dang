# Directory the vendored SDK lives in, relative to a module root, and the files
# a module needs from sdk/ to compile. Top-level lets are file-scoped in Dang, so
# these are kept in step with the same constants in mod.dang — this file seeds
# them at init, that one refreshes them on generate. If they drift, a seeded
# module and a generated one disagree about what a module contains.
let genDir = "dagger"
let vendoredSdkFiles: [String!]! = ["LICENSE", "Cargo.toml", "src/**/*.rs", "macros/Cargo.toml", "macros/src/**/*.rs"]

# Toolchain the init helper is built with, and where cargo puts things. Kept in
# step with the same constants in mod.dang and runtime/main.dang: the helper is
# a goish binary like everything else here, so it needs the same image, the same
# target tuple, and both halves of cargo's download cache — git dependencies
# land under $CARGO_HOME/git, not $CARGO_HOME/registry, and goish is one. The
# image's version is mirrored again by RUST_VERSION in
# .github/workflows/rust.yml, which builds the same crates outside the engine.
let rustImage = "rust:1.90-bookworm@sha256:3914072ca0c3b8aad871db9169a651ccfce30cf58303e5d6f2db16d1d8a7e58f"
let cargoTarget = "x86_64-unknown-linux-gnu"
let cargoTargetDir = "/render-template-target"
let cargoRegistryDir = "/usr/local/cargo/registry"
let cargoGitDir = "/usr/local/cargo/git"

# The files the init helper needs in order to build. Naming them keeps a
# developer's local `target/` — a few hundred megabytes of goish object files —
# out of the container every init would otherwise copy it into.
let helperFiles: [String!]! = ["Cargo.toml", "Cargo.lock", ".cargo/**", "src/**"]

# Where the built helper lands in the container that runs it.
let helperPath = "/usr/local/bin/render-template"

# Multi-arch build constants, kept in step with mod.dang and runtime/main.dang —
# top-level `let` is file-scoped in Dang, so all three files carry a copy. The
# helper is a goish binary, so it is x86_64 like everything else here: it builds
# on the engine's own platform and cross-links, then *runs* on servePlatform.
let servePlatform: Platform! = "linux/amd64"
let crossLinkerEnv = "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER"
let crossLinker = "x86_64-linux-gnu-gcc"
let crossToolchainSetup = "test \"$(uname -m)\" = x86_64 || { apt-get update -qq && apt-get install -y -qq --no-install-recommends gcc-x86-64-linux-gnu; }"
let runImage = "alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc"
let buildHostKey: String! {
  if (defaultPlatform == "linux/amd64") {
    "linux-amd64"
  } else {
    if (defaultPlatform == "linux/arm64") { "linux-arm64" } else { "other" }
  }
}

"""
Manage Dagger modules that use the Rust SDK.
"""
type RustSdk {
  """
  Config filenames that mark a Dagger module root: the CLI 1.0
  `dagger-module.toml` (workspace-managed modules) and the legacy `dagger.json`.
  A managed module is discovered by whichever it uses.
  """
  let moduleConfigFilenames: [String!]! = ["dagger-module.toml", "dagger.json"]

  """
  Directory trees never searched for module roots: Cargo build output and
  vendored crates hold copies of module config that are not modules.
  """
  let discoveryExcludes: [String!]! = ["**/target/**", "**/vendor/**"]

  """
  Marker filename that skips generate when found at or above a Rust SDK module root.
  """
  pub skipGenerateFilename: String! = ".dagger-rust-sdk-skip-generate"

  """
  Runtime source to write into modules created by this SDK.

  Rust has no built-in engine runtime, so new modules point at this
  repository's build-only runtime module.
  """
  pub targetRuntime: String! { "github.com/wingyplus/rust-sdk/runtime" }

  """
  Starter used by init when none is named.
  """
  let defaultTemplate: String! = "default"

  """
  Return init templates tracked by this module.

  Templates live under templates/<name> and are materialized into the new
  module before generation. Init picks one by name, or the module default when
  none is named.
  """
  pub templates: [Template!]! {
    if (currentModule.source.exists("templates")) {
      let root = currentModule.source.directory("templates")
      root.entries.map { name =>
        Template(
          name: name.trimSuffix("/"),
          source: root.directory(name),
        )
      }
    } else {
      directory.entries.map { name =>
        Template(
          name: name,
          source: directory,
        )
      }
    }
  }

  """
  Return every Rust SDK module this workspace manages that is visible from the
  client's current location.

  Discovery is anchored at the client's cwd, not the workspace root: the
  nearest enclosing module plus every managed module at or below the cwd.
  Running from a subdirectory acts on the project you're in — and the projects
  beneath it — not the whole workspace.
  """
  pub modules(ws: Workspace!): [Mod!]! {
    let managed = currentModule.asSDK(workspace: ws).modules.{{path}}
    let cwd = normalizePath(ws.cwd)
    polyfill
      .workspace(ws)
      .findConfigDirs(moduleConfigFilenames, exclude: discoveryExcludes)
      .map { dir => workspacePath(cwd, dir) }
      .uniq
      .filter { path => managed.filter { m => normalizePath(m.path) == path }.length > 0 }
      .map { path => Mod(rootPath: path, ws: ws, skipGenerateFilename: skipGenerateFilename) }
  }

  """
  Return the Rust SDK module at or above a workspace path.

  When `findUp` is true, `path` may point inside the module.
  """
  pub mod(ws: Workspace!, path: String! = ".", findUp: Boolean! = true): Mod! {
    let modPath = if (findUp) {
      let needle = normalizePath(path)

      let asSdkBase = managedBase(ws, needle)
      let foundToml = ws.findUp("dagger-module.toml", path)
      let foundJson = ws.findUp("dagger.json", path)
      let tomlBase = if (foundToml == null) { null } else {
        configDir(foundToml, "dagger-module.toml")
      }
      let jsonBase = if (foundJson == null) { null } else {
        configDir(foundJson, "dagger.json")
      }

      # Every candidate is an ancestor of `path`, so they lie on one chain and
      # the deepest is the owning module. Resolving each source separately and
      # falling back in order would let a shallow as-sdk entry or an ancestor's
      # dagger-module.toml shadow a deeper module in a partially-migrated repo.
      let asSdkDepth = baseDepth(asSdkBase)
      let tomlDepth = baseDepth(tomlBase)
      let jsonDepth = baseDepth(jsonBase)
      let best = maxDepth(maxDepth(asSdkDepth, tomlDepth), jsonDepth)

      if (asSdkBase != null and asSdkDepth == best) {
        asSdkBase
      } else if (tomlBase != null and tomlDepth == best) {
        resolveTomlBase(ws, tomlBase, path)
      } else if (jsonBase != null and jsonDepth == best) {
        resolveJsonBase(ws, jsonBase, path)
      } else {
        raise "no Dagger module found containing path: " + path
      }
    } else {
      normalizePath(path)
    }

    Mod(
      rootPath: modPath,
      ws: ws,
      skipGenerateFilename: skipGenerateFilename,
    )
  }

  """
  Initialize Rust-owned files for a new Dagger module.

  The engine resolves the destination `path` and owns the module's config; this
  function only returns the SDK-owned starter source to layer onto `path`.

  Pass `template` to pick a starter under templates/<template>; it defaults to
  `default` (a small working module).

  The starter is seeded with a working `dagger/`, so the new module builds
  and loads immediately. `dagger generate` then replaces its bindings with ones
  derived from the module's own schema — see `seedSdk` for why that ordering is
  load-bearing rather than a convenience.
  """
  pub initModule(
    ws: Workspace!,
    name: String!,
    path: String!,
    """
    Starter to materialize from templates/<template>: `default` for a small working module, `empty` for a bare module.
    """
    template: String! = defaultTemplate,
  ): Changeset! {
    let rawPath = path.trimPrefix("./").trimPrefix("/")
    let modPath = if (rawPath == "" or rawPath == ".") {
      "."
    } else if (rawPath == ".." or rawPath.trimPrefix("../") != rawPath) {
      raise "path escapes workspace: " + rawPath
    } else {
      rawPath.trimSuffix("/")
    }

    # An empty name means "the default", not the templates/ directory itself —
    # which exists, so it would pass the check below and render every starter as
    # a subdirectory of the new module.
    let starter = if (template == "") { defaultTemplate } else { template }

    if (currentModule.source.exists("templates/" + starter) == false) {
      raise "unknown init template: " + starter
    } else {
      polyfill.workspace(ws).fork
        .withDirectory(modPath, renderedTemplate(name, starter))
        .withDirectory(Path(modPath).join(Path(genDir)).string, seedSdk)
        .changes
    }
  }

  """
  The vendored SDK a new module is seeded with.

  Seeding this at init — rather than leaving it for `dagger generate` — is what
  keeps a new module buildable from the moment it exists, and that matters more
  than it looks. The engine discovers a workspace's generators by *loading* every
  module in it, and loading a Rust module builds it. A module whose `Cargo.toml`
  names a `dagger/` that is not there yet cannot build, so it cannot load, so
  `dagger generate` cannot even enumerate what to generate: generation would need
  to have already run for generation to be possible.

  The bindings under `src/gen` are the checked-in placeholder; `dagger generate`
  replaces that directory with ones derived from the module's own schema. Until
  it runs, the module compiles and serves — it just has no API surface to offer.
  """
  let seedSdk: Directory! {
    currentModule.source.directory("sdk").filter(include: vendoredSdkFiles)
  }

  """
  Generate every managed Rust SDK module visible from the client's current
  location: running from a subdirectory generates only the project you're in
  and the projects beneath it.

  Modules with the generate skip marker are skipped.
  """
  pub generateAll(ws: Workspace!): Changeset! @generate {
    changeset.withChangesets(
      modules(ws)
        .filter { mod => mod.skipGenerate == false }
        .map { mod => mod.generate },
    )
  }

  """
  Render the templates/<template> starter with the requested module name.

  The helper is `no_std` Rust on goish, so — like sdk/codegen — it carries its
  own `.cargo/config.toml` and the binary lands under the target tuple rather
  than directly in `release/`. It is built `--release` because a debug goish
  build renders the same starter roughly four hundred times slower, and its
  own crate skips LTO because nothing here ships — see its Cargo.toml.
  """
  let renderedTemplate(name: String!, template: String!): Directory! {
    # Build on the engine's own platform and cross-link to cargoTarget, so rustc
    # runs natively rather than under emulation. Without `rustup target add` this
    # fails on a non-x86_64 engine with "E0463: can't find crate for `core`", and
    # without the cross driver it gets as far as the link step and dies on
    # "unrecognized command-line option '-m64'".
    let helperBinary = container()
      .from(rustImage)
      .withoutEntrypoint
      .withExec(["rustup", "target", "add", cargoTarget])
      .withExec(["sh", "-c", crossToolchainSetup])
      .withEnvVariable(crossLinkerEnv, crossLinker)
      .withDirectory("/helper", currentModule.source.directory("helpers/render-template").filter(include: helperFiles))
      .withWorkdir("/helper")
      # Build outside the source tree: a cache mount inside /helper would sit
      # under the directory written above it.
      .withEnvVariable("CARGO_TARGET_DIR", cargoTargetDir)
      .withEnvVariable("CARGO_NET_GIT_FETCH_WITH_CLI", "true")
      .withMountedCache(cargoRegistryDir, cacheVolume("rust-sdk-cargo-registry"))
      .withMountedCache(cargoGitDir, cacheVolume("rust-sdk-cargo-git"))
      # Object caches are keyed by build host: cargo puts host build scripts and
      # proc-macro .so files under $CARGO_TARGET_DIR/release/, and an engine of
      # the other architecture cannot exec them.
      .withMountedCache(cargoTargetDir, cacheVolume("rust-sdk-render-template-target-" + buildHostKey))
      .withExec(["cargo", "build", "--release", "--locked", "--bin", "render-template"])
      .withExec(["cp", cargoTargetDir + "/" + cargoTarget + "/release/render-template", helperPath])
      .file(helperPath)

    # Run it on servePlatform: the helper is x86_64 whatever built it, so it
    # cannot be exec'd in a native container on an arm64 engine. runImage is a
    # small base — see that constant for why it is not `scratch`.
    container(platform: servePlatform)
      .from(runImage)
      .withFile(helperPath, helperBinary, permissions: 493)
      .withDirectory("/template", currentModule.source.directory("templates/" + template))
      .withExec([helperPath, name, "/template", "/rendered"])
      .directory("/rendered")
  }

  """
  Return the deepest workspace-managed module containing `path`, or null when
  this SDK manages none of its ancestors.

  The workspace's [[modules.<sdk>.as-sdk.modules]] entries are the source of
  truth for SDK-managed modules, so membership needs no config sniffing.
  """
  let managedBase(ws: Workspace!, path: String!): String {
    # asSDK raises when this module is not installed as an SDK in the active
    # workspace, which is the normal case for a legacy dagger.json-only repo.
    # The `.{{path}}` selection is what executes the query, so it must sit
    # inside the guard.
    let managed = currentModule.asSDK(workspace: ws).modules.{{path}} rescue []

    managed
      .map { m => normalizePath(m.path) }
      .filter { base => pathContains(base, path) }
      .reduce(null) { best, base =>
        if (best == null) {
          base
        } else if (pathDepth(base) > pathDepth(best)) {
          base
        } else {
          best
        }
      }
  }

  let resolveTomlBase(ws: Workspace!, base: String!, path: String!): String! {
    let runtimeSource = tomlRuntimeSource(ws, base)
    if (isRustRuntime(runtimeSource)) {
      base
    } else if (runtimeSource == "") {
      raise "Dagger module does not use the Rust SDK: " + path
    } else {
      raise "Dagger module does not use the Rust SDK: " + path + " (runtime source: " + runtimeSource + ")"
    }
  }

  let resolveJsonBase(ws: Workspace!, base: String!, path: String!): String! {
    let configPath = if (base == ".") { "dagger.json" } else { base + "/dagger.json" }
    if (ws
      .directory("/", include: [configPath])
      .file(configPath)
      # Accepts the bare name and this repository's ref, mirroring
      # isRustRuntime. A legacy dagger.json cannot name a built-in `rust`
      # runtime — there isn't one — so in practice it names the SDK by ref, and
      # matching only "rust" would reject every real legacy module.
      .search(
        pattern: "\"sdk\"\\s*:\\s*\\{[^}]*\"source\"\\s*:\\s*\"(rust|github\\.com/wingyplus/rust-sdk[^\"]*)\"",
        multiline: true,
        dotall: true,
        limit: 1,
      ).{{id}}
      .length == 0) {
      raise "Dagger module does not use the Rust SDK: " + path
    } else {
      base
    }
  }

  """
  Whether a `[runtime] source` value names this SDK's runtime.

  Accepts the bare `rust` name as well as this repository's runtime ref, with
  or without a version suffix.
  """
  let isRustRuntime(source: String!): Boolean! {
    source == "rust"
      or source == targetRuntime
      or source.hasPrefix(targetRuntime + "@")
  }

  """
  Return the runtime source declared by a module's dagger-module.toml, or ""
  when it declares none.

  Only a quoted `source` on its own line of a literal [runtime] section is
  recognized; inline tables and other TOML spellings read as no declaration,
  which callers reject rather than mistake for Rust.
  """
  let tomlRuntimeSource(ws: Workspace!, base: String!): String! {
    let configPath = if (base == ".") { "dagger-module.toml" } else { base + "/dagger-module.toml" }
    let matches = ws
      .directory("/", include: [configPath])
      .file(configPath)
      .search(
        pattern: "^[ \\t]*\\[runtime\\][^\\[]*?^[ \\t]*source[ \\t]*=[ \\t]*(?:\"[^\"]*\"|'[^']*')",
        multiline: true,
        limit: 1,
      ).{{matchedLines}}

    matches
      .map { m => runtimeSourceValue(m.matchedLines) }
      .reduce("") { acc, source => if (acc == "") { source } else { acc } }
  }

  """
  Extract the runtime source value out of a matched [runtime] block.

  The match stops at the first uncommented assignment, so the value lives on
  the block's last line, ahead of any trailing comment.
  """
  let runtimeSourceValue(block: String!): String! {
    let sourceLine = block.trimSpace.split("\n").reduce("") { acc, line => line }
    let assignment = sourceLine.split("#").reduce("") { acc, part => if (acc == "") { part } else { acc } }.trimSpace
    let quote = if (assignment.trimSuffix("'") == assignment) { "\"" } else { "'" }

    assignment.trimSuffix(quote).split(quote).reduce("") { acc, part => part }
  }

  """
  Resolve a cwd-relative path — at or below the cwd ("." , "sub/dir") or a
  strict ancestor (".." , "../..") — against the cwd into a
  workspace-root-relative path.
  """
  let workspacePath(cwd: String!, path: String!): String! {
    let base = if (cwd == ".") { [] } else { cwd.split("/") }
    let segments = path.split("/").reduce(base) { acc, segment =>
      if (segment == "..") {
        acc.dropLast(1)
      } else if (segment == "." or segment == "") {
        acc
      } else {
        acc + [segment]
      }
    }
    if (segments.length == 0) { "." } else { segments.join("/") }
  }

  let normalizePath(path: String!): String! {
    let normalized = path.trimPrefix("./").trimPrefix("/").trimSuffix("/")
    if (normalized == "") { "." } else { normalized }
  }

  let pathDepth(path: String!): Int! {
    if (path == ".") { 0 } else { path.split("/").length }
  }

  let pathContains(base: String!, path: String!): Boolean! {
    base == "." or path == base or path.hasPrefix(base + "/")
  }

  let baseDepth(base: String): Int! {
    if (base == null) { -1 } else { pathDepth(base) }
  }

  let maxDepth(a: Int!, b: Int!): Int! {
    if (b > a) { b } else { a }
  }

  let configDir(foundPath: String!, marker: String!): String! {
    normalizePath(foundPath.trimPrefix("/").trimSuffix(marker))
  }
}
