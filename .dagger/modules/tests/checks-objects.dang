"""
Checks for engine objects crossing the module call boundary.

An object is passed to a module, and returned from one, as an engine ID: an
argument arrives as an ID and is rebuilt through `ObjectId::from_id`, and a
returned one is resolved back to its ID, which is a round trip and so can fail.
`sdk/codegen` emits that impl for every object the engine has a loader for, and
nothing until now called one.
"""
type ObjectChecks {
  let harness: TestHarness!

  """
  A `Directory` argument the caller passes should reach the function.
  """
  pub acceptsADirectory(ws: Workspace!): Void @check {
    let target = harness.target(ws)

    harness.modTarget(ws).assertJsonOutput(
      ["count-entries", "--dir", target.modulePath + "/testdata"],
      "4",
      "a Directory argument should be rebuilt from its id and carry its entries",
    )
  }

  """
  A list of `Directory` arguments should reach the function, each one rebuilt.

  A list of objects arrives as a list of *ids*, so the whole list goes through
  `from_ids` — `ObjectId::from_id` once per element — before the function sees
  it. Counting the entries of both directories is what shows each element
  resolves on its own: a list that rebuilt only its first element would count
  4 rather than 5.

  The other direction is not called here, and cannot be: `dagger call` has no
  spelling for chaining into an element of a list. `dirsOut` in the fixture
  returns one anyway, so the `LIST_KIND`-wrapping-`OBJECT_KIND` typedef is
  registered — and validated by the engine — every time this suite loads the
  module. What `encode_object_list` writes is pinned in `sdk/tests/module.rs`.
  """
  pub acceptsAListOfDirectories(ws: Workspace!): Void @check {
    let target = harness.target(ws)

    harness.modTarget(ws).assertJsonOutput(
      [
        "count-all-entries",
        "--dirs", target.modulePath + "/testdata",
        "--dirs", target.modulePath + "/testdata/nested",
      ],
      "5",
      "every element of a Directory list should be rebuilt from its id",
    )
  }

  """
  `default_path` and `ignore` should load a contextual argument the caller never
  supplies, and filter it.

  Both options apply to a `Directory` or `File` only, the way the engine has it;
  writing either on a scalar is a compile error naming the parameter, which is
  `sdk/macros`'s business rather than this suite's. What is checked here is that
  the engine honours them: `testdata/` arrives with no argument given, and
  `notes.log` does not arrive at all.
  """
  pub loadsAContextualDirectory(ws: Workspace!): Void @check {
    let target = harness.modTarget(ws)

    target.assertJsonStringContains(
      ["entries"],
      "a.txt",
      "default_path should load testdata/ when the caller passes nothing",
    )
    target.assertJsonStringContains(["entries"], "b.txt", "default_path should load testdata/")

    # Spelled out rather than reached for: mod-test's negative assertion is
    # `assertJsonListNotContains`, which looks for a *quoted* element of a JSON
    # list. This function returns a joined string, so that would never match and
    # would pass whatever the directory contained.
    let listed = target.tryCall(["entries"])
    listed.assertSuccess
    assert("ignore should drop *.log before the function sees the directory") {
      listed.stdout.contains("notes.log") == false
    }
  }

  """
  A function returning an object should hand back something the CLI can go on
  chaining from.
  """
  pub returnsAContainer(ws: Workspace!): Void @check {
    harness.modTarget(ws).assertJsonString(
      ["container-out", "stdout"],
      "container-out",
      "a returned Container should resolve to an id the CLI can chain from",
    )
  }

  """
  A fallible function should be able to return an object too.

  Two failures meet in that one signature and only one of them is new: the
  dispatch has always had to resolve a returned object's id, which is a round
  trip, and now the function it resolves for may itself have failed first. The
  emitted call is `encode_object(&(f())?)?` — the inner `?` the function's, the
  outer one the id's — and getting the two the wrong way round is a borrow of
  the `Result` rather than of the object.
  """
  pub returnsAContainerFallibly(ws: Workspace!): Void @check {
    harness.modTarget(ws).assertJsonString(
      ["try-container-out", "stdout"],
      "try-object",
      "a Result<Container, string> should resolve to an id the CLI can chain from",
    )
  }

  """
  A function returning `Option<Container>` should hand back a chainable object
  or a null.

  The absent half is the interesting one, and it is why the dispatch matches on
  the `Option` rather than mapping over it: resolving a returned object's id is
  a round trip, so a `None` that reached `encode_object` anyway would either
  fail the call or quietly resolve something the function never returned.
  Nothing about a present `Container` shows that, since resolving one is what it
  is supposed to do.

  Both halves are read through a field selected off the container rather than
  from the object itself, and that is the CLI's constraint rather than a choice:
  `dagger call optional-container` on its own ends at the object, and `printID`
  in v1.0.0-beta.9 — the release mod-test installs — has no case for a nil
  response, so it fails the call with `printID: unexpected type for object:
  <nil>` whatever the module returned. Upstream has since grown that case;
  selecting a field works on both.

  Selecting `stdout` still tells the three outcomes apart, which is all the
  assertion needs: a resolved id prints what the container echoed, a failure
  exits non-zero, and only a null prints `null`.
  """
  pub returnsAnOptionalContainer(ws: Workspace!): Void @check {
    let target = harness.modTarget(ws)

    target.assertJsonString(
      ["optional-container", "--present=true", "stdout"],
      "optional-container",
      "a Some should resolve to an id the CLI can chain from",
    )
    target.assertJsonOutput(
      ["optional-container", "stdout"],
      "null",
      "a None should be a null rather than a resolved id or a failure",
    )
  }
}
