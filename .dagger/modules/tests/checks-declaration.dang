"""
Checks for the function and argument surface `sdk/macros` declares.

`sdk/macros` is a proc-macro crate, so it is built for the host and has no goish
in it, and its tests are ordinary `#[test]` functions. They reach the type
mapping and the text emitted for one hand-built signature, and no further: the
`proc_macro` API panics when called outside a macro expansion, so nothing that
touches a `TokenTree` is testable there. These checks are the other half —
compile a module that uses the whole attribute surface, and call it.
"""
type DeclarationChecks {
  let harness: TestHarness!

  """
  A function should take an argument and return a value.
  """
  pub roundTripsAnArgument(ws: Workspace!): Void @check {
    harness.modTarget(ws).assertJsonString(["echo", "--string-arg", "hi"], "hi")
  }

  """
  `#[dagger(default = ...)]` should apply when the caller omits the argument,
  and yield to the caller when they do not.

  All four literal shapes are here on purpose: a quoted string, a bare integer,
  a bare float and a bare `true` reach the macro as different token trees.
  """
  pub defaultsApply(ws: Workspace!): Void @check {
    let target = harness.modTarget(ws)

    target.assertJsonString(["with-default"], "hello")
    target.assertJsonString(["with-default", "--value", "supplied"], "supplied")
    target.assertJsonOutput(["with-default-int"], "3")
    target.assertJsonOutput(["with-default-int", "--n", "7"], "7")
    target.assertJsonOutput(["with-default-float"], "1.5")
    target.assertJsonOutput(["with-default-float", "--factor", "2.5"], "2.5")
    target.assertJsonOutput(["with-default-bool"], "true")
    # `--flag=false`, not `--flag false`: a boolean flag takes its value
    # attached, and the split form makes the CLI read `false` as a subcommand.
    target.assertJsonOutput(["with-default-bool", "--flag=false"], "false")
  }

  """
  A float should cross the boundary in both directions, and stay a float.

  The failure this guards against is not a broken call but a changed value:
  `kind_of` used to have no `FLOAT_KIND` at all, and the two ways to add one
  badly — declaring `INTEGER_KIND`, or encoding the result with `encode_int` —
  both leave a function that answers, with the fraction gone. So the assertions
  are on values a truncating path could not produce.

  `half` is here as well as `floatRoundTrip` because a round trip alone proves
  less than it looks: the argument the caller spelled could be echoed back
  through a string and still read as `2.5`. `7` in and `3.5` out is a number the
  module computed, and it is the encoder that has to render it.
  """
  pub floatsCrossTheBoundary(ws: Workspace!): Void @check {
    let target = harness.modTarget(ws)

    target.assertJsonOutput(["float-round-trip", "--factor", "2.5"], "2.5")
    target.assertJsonOutput(["half", "--factor", "7"], "3.5")
  }

  """
  An `Option<T>` argument should be optional, and arrive as absent when omitted.

  There is no `+optional` marker to write in Rust — optionality is carried by
  the type — so this is the only thing that shows the macro read it.
  """
  pub optionalArgumentsMayBeOmitted(ws: Workspace!): Void @check {
    let target = harness.modTarget(ws)

    target.assertJsonString(["optional-arg"], "none")
    target.assertJsonString(["optional-arg", "--value", "v"], "some:v")
  }

  """
  A list should cross the boundary in both directions.

  The caller repeats the flag — `--values a --values b` — and what arrives is
  one JSON array, decoded element by element; what goes back is another. Every
  element kind that has its own accessor and its own encoder is here, because
  the string one passing says nothing about the integer or the float one — and
  the float is halved rather than echoed, so the encoder is shown on a value
  the caller did not spell.

  The empty list is the third case rather than an edge of the first two: it is
  where "no elements" and "no argument" could be confused, and `[]` rather than
  `null` is what a caller branches on.
  """
  pub listsCrossTheBoundary(ws: Workspace!): Void @check {
    let target = harness.modTarget(ws)

    target.assertJsonListContains(
      ["echo-list", "--values", "a", "--values", "b"],
      "a",
      "a repeated flag should arrive as the first element of the list",
    )
    target.assertJsonListContains(
      ["echo-list", "--values", "a", "--values", "b"],
      "b",
      "a repeated flag should arrive as the second element of the list",
    )

    # Not `assertJsonListContains`, which looks for a *quoted* element: these
    # are JSON numbers, so the quoted form would never match.
    let doubled = target.tryCall(["doubled", "--numbers", "2", "--numbers", "3"])
    doubled.assertSuccess
    assert("a list of integers should decode and encode element by element") {
      doubled.stdout.contains("4") and doubled.stdout.contains("6")
    }

    let halved = target.tryCall(["halved", "--numbers", "7", "--numbers", "5"])
    halved.assertSuccess
    assert("a list of floats should keep its fraction through the encoder") {
      halved.stdout.contains("3.5") and halved.stdout.contains("2.5")
    }

    target.assertJsonListEmpty(["empty-list"], "an empty list should come back as []")
  }

  """
  An `Option<slice<T>>` argument should be optional, and arrive as absent when
  omitted.

  The `Option` wraps the *list*, which is the only place it may appear around
  one: the engine's `withOptional` applies to whichever typedef it is called on,
  and a list whose elements may be null is refused by the macro rather than
  declared. So this is `optionalArgumentsMayBeOmitted` again, one type further
  out.
  """
  pub optionalListsMayBeOmitted(ws: Workspace!): Void @check {
    let target = harness.modTarget(ws)

    target.assertJsonString(["optional-list"], "none")
    target.assertJsonString(
      ["optional-list", "--values", "x", "--values", "y"],
      "some:x,y",
    )
  }

  """
  A failing function should exit non-zero, and say why.

  `dagger::fail` writes to stderr and exits 2. The exit code is the half a
  caller branches on, and it would be satisfied by a module that died silently;
  the message is the half a caller reads, and the engine surfacing a module's
  stderr is the whole of how it gets there.
  """
  pub failuresPropagate(ws: Workspace!): Void @check {
    let target = harness.target(ws)

    harness.modTarget(ws).assertFailure(["boom"], "boom should exit non-zero")

    target
      .run(["api", "call", "-m", "/work/" + target.modulePath, "boom"])
      .assertStderrContains(
        "dagger: intentional failure",
        "the message dagger::fail wrote should reach the caller's stderr",
      )
  }

  """
  A function returning `Result<T, string>` should hand back the value it
  produced, and its `Err` should fail the call.

  Both halves are the point of a fallible signature. `tryLeaf` shows that the
  engine was told what the function *produces* — the `Result` is peeled off
  before the return kind is declared, so a `Result<string, string>` is a String
  function like any other, and a caller sees no trace of it. `tryBoom` shows the
  other end reaching the same place `dagger::fail` does: `invoke` returns the
  same `Result`, so an `Err` needs no encoder, just the `?` the dispatch adds.

  `failuresPropagate` above is the same assertion against a function that
  diverges instead. The two are worth having side by side: the message a caller
  reads is the one thing that must not depend on which way the module chose to
  fail.
  """
  pub fallibleFunctionsReturnOrFail(ws: Workspace!): Void @check {
    let target = harness.target(ws)

    harness.modTarget(ws).assertJsonString(
      ["try-leaf"],
      "try-leaf",
      "a Result return should hand back the value inside its Ok",
    )
    harness.modTarget(ws).assertFailure(["try-boom"], "an Err should exit non-zero")

    target
      .run(["api", "call", "-m", "/work/" + target.modulePath, "try-boom"])
      .assertStderrContains(
        "dagger: intentional Err",
        "the message an Err carried should reach the caller's stderr",
      )
  }

  """
  A function may fail with goish's `error` as well as with a message.

  The two are not interchangeable and both have to work: a client method fails
  with the message itself, and goish's own APIs fail with an `error`, so which
  one a function returns follows from whose work it is doing. The dispatch reads
  the message off an `error` through `error_message` rather than through
  `Error()`, which panics on the nil error — a module that returned `Err(nil)`
  gets a vague failure rather than a panic, and either way the caller reads one
  message on stderr.
  """
  pub fallibleFunctionsMayCarryAGoishError(ws: Workspace!): Void @check {
    let target = harness.target(ws)

    harness.modTarget(ws).assertJsonString(
      ["try-error"],
      "try-error",
      "a Result<T, error> should hand back the value inside its Ok",
    )

    target
      .run(["api", "call", "-m", "/work/" + target.modulePath, "try-error", "--boom=true"])
      .assertStderrContains(
        "dagger: intentional goish error",
        "the message a goish error carried should reach the caller's stderr",
      )
  }

  """
  A function that returns nothing should be callable, in both spellings.

  Void is reached elsewhere in this suite only through `#[dagger::check]`, which
  runs the same encoder but is declared `is_check: true` and is reached by
  `dagger check` rather than by a call. What is unproven until here is the pair
  an ordinary call needs to agree on: the engine accepting a `Void` return on a
  function that is not a check, and `encode_void`'s `null` being what it expects
  back for one. A return kind and an encoder that disagree — `STRING_KIND`
  against `null` — fail the call, so succeeding is the assertion.

  Both spellings are compiled because they differ to the parser rather than to
  the reader: with no `->` at all the parsed return type is the empty string,
  and `-> ()` arrives as the text `()`. `kind_of` maps both to `VOID_KIND`.
  """
  pub voidReturnsAreCallable(ws: Workspace!): Void @check {
    let target = harness.target(ws)

    target
      .run(["api", "call", "-m", "/work/" + target.modulePath, "returns-nothing"])
      .assertSuccess

    target
      .run(["api", "call", "-m", "/work/" + target.modulePath, "returns-unit"])
      .assertSuccess
  }

  """
  An enum the module declares should survive the round trip, in both
  directions.

  Three spellings of one member meet here, and keeping them apart is the whole
  of what `#[dagger::enum_type]` has to get right. The Rust variant is
  `DebianTesting`; the engine publishes the member as `DEBIAN_TESTING`, which is
  what a caller writes; and what crosses the call boundary is the variant name
  again, because the engine hands a module its own spelling back. A module that
  registered the member under the wrong one of those fails here rather than
  somewhere inside a call.

  The optional half also shows the module received a *variant* and not a
  string: `osLibc` reaches its answer by matching on one.
  """
  pub enumsRoundTrip(ws: Workspace!): Void @check {
    let target = harness.modTarget(ws)

    target.assertJsonString(["echo-os", "--os", "ALPINE"], "ALPINE")
    target.assertJsonString(
      ["echo-os", "--os", "DEBIAN_TESTING"],
      "DEBIAN_TESTING",
      "a two-word variant should come back as the member the engine published",
    )
    target.assertJsonString(["os-libc", "--os", "DEBIAN"], "glibc")
    target.assertJsonString(["os-libc"], "unset", "an optional enum may be omitted")
  }

  """
  A member the enum does not have should be refused.

  The engine holds a call to the members the module declared, so this is what
  keeps a misspelling from arriving at the dispatch as a name it would have to
  invent an answer for. `from_member` refuses one too — its message is what
  `sdk`'s own suite asserts on — but nothing should ever reach it.
  """
  pub unknownEnumMembersAreRejected(ws: Workspace!): Void @check {
    harness.modTarget(ws).assertFailure(
      ["echo-os", "--os", "PLAN9"],
      "a member the enum does not declare should be rejected",
    )
  }

  """
  A function returning `Option<T>` should hand back a value or a null, and
  neither should be a failure.

  `optionalArgumentsMayBeOmitted` above is the same type in the other position,
  and the two are declared by the same `Option<T>` — but only the return half
  has an encoding to get wrong. A `None` is written as JSON null, and the return
  typedef carries `withOptional`, so the two have to agree: a return declared
  non-optional that encoded `null` fails the call, and a return declared
  optional whose encoder wrote a value would be a nullable field that is never
  null.

  The Boolean pair is the one that would go unnoticed otherwise. `null` and
  `false` are both falsey to a caller, so a dispatch that dropped the `Option`
  and encoded `Some(false)` and `None` alike would still look plausible; the
  function returns `Some(false)` on purpose so the two answers have to differ.

  The last pair is a fallible optional, which is where the `?` and the `Option`
  meet: the dispatch runs the `?` first and matches on what it yields, and
  getting that order wrong matches on a `Result`.
  """
  pub optionalReturnsMayBeAbsent(ws: Workspace!): Void @check {
    let target = harness.modTarget(ws)

    target.assertJsonString(["optional-string", "--present=true"], "present")
    target.assertJsonOutput(
      ["optional-string"],
      "null",
      "a None should reach the caller as JSON null rather than as a failure",
    )

    target.assertJsonOutput(["optional-int", "--present=true"], "7")
    target.assertJsonOutput(["optional-int"], "null")

    target.assertJsonOutput(
      ["optional-bool", "--present=true"],
      "false",
      "Some(false) and None are different answers, and both are falsey",
    )
    target.assertJsonOutput(["optional-bool"], "null")

    target.assertJsonString(["try-optional-string", "--present=true"], "try-optional")
    target.assertJsonOutput(
      ["try-optional-string"],
      "null",
      "a Result<Option<T>, string> should be able to succeed with nothing",
    )
  }

  """
  An enum's name, its members and their doc comments should reach the schema.

  The type is `FeatureMatrixTargetOs` rather than `TargetOs` because the engine
  namespaces a module's own types with the module's name — the same rule that
  leaves the main object called `FeatureMatrix` — so asserting on the
  un-namespaced name would be asserting on a type nothing has.

  Like `argumentMetadataIsDeclared` below, the descriptions have no behavioural
  shadow: nothing a call returns says whether the doc comments were declared, so
  the schema is the only place to look.
  """
  pub enumMetadataIsDeclared(ws: Workspace!): Void @check {
    let target = harness.target(ws)
    let document = "{__type(name:\"FeatureMatrixTargetOs\"){enumValues{name description}}}"

    target
      .query(document)
      .assertStdoutContains(
        "DEBIAN_TESTING",
        "a variant should reach the schema as the engine's spelling of its name",
      )

    target
      .query(document)
      .assertStdoutContains(
        "Alpine Linux, the musl one.",
        "a variant's doc comment should become the member's description",
      )
  }

  """
  `#[dagger(doc = ...)]` and `#[dagger(deprecated = ...)]` should reach the
  engine.

  Both are declaration metadata with no behavioural shadow, so unlike everything
  else here they cannot be asserted by calling the function.

  They are also not read back the same way. A description survives into the
  CLI's own help, which is where a user meets it. A deprecation does not — the
  help for a deprecated argument is indistinguishable from any other — so the
  only place to see whether the macro declared it is the schema the module
  serves.
  """
  pub argumentMetadataIsDeclared(ws: Workspace!): Void @check {
    let target = harness.target(ws)

    target
      .run(["api", "call", "-m", "/work/" + target.modulePath, "documented", "--help"])
      .assertStdoutContains(
        "The value to echo back",
        "the doc option should become the argument's description",
      )

    # `includeDeprecated: true` is not optional here, and leaving it off looks
    # like the macro dropped the argument: GraphQL hides deprecated items from
    # introspection by default, so `deprecatedArg` comes back with no arguments
    # at all rather than with a deprecated one.
    target
      .query(
        "{__type(name:\"FeatureMatrix\"){fields{name args(includeDeprecated:true){name deprecationReason}}}}",
      )
      .assertStdoutContains(
        "use documented instead",
        "the deprecated option should reach the schema as the argument's deprecationReason",
      )
  }

  """
  The `///` comment on the annotated `impl` block should become the object's
  description, and `#[dagger::function(deprecated = ...)]` the function's
  deprecation.

  Both are declaration metadata with no behavioural shadow, so they are read
  back out of the schema the module serves, the way `argumentMetadataIsDeclared`
  reads an argument's. The object's description is the one place a Rust module
  can say what it *is*: the macro is handed the `impl` block and nothing else,
  so a doc comment on the `struct` — or the crate's `//!` — never reaches it.
  The fixture's block comment is worded so that finding it proves the macro read
  the block rather than the struct.

  `includeDeprecated: true` is as load-bearing here as it is for an argument,
  and for the same reason: a deprecated field is hidden from introspection by
  default, so leaving it off looks exactly like a macro that dropped the
  function.
  """
  pub declarationMetadataIsDeclared(ws: Workspace!): Void @check {
    let target = harness.target(ws)

    target
      .query("{__type(name:\"FeatureMatrix\"){description}}")
      .assertStdoutContains(
        "Every Rust SDK feature the end-to-end suite asserts on.",
        "the impl block's doc comment should become the object's description",
      )

    target
      .query(
        "{__type(name:\"FeatureMatrix\"){fields(includeDeprecated:true){name deprecationReason}}}",
      )
      .assertStdoutContains(
        "use echo instead",
        "#[dagger::function(deprecated = ...)] should reach the schema as the field's deprecationReason",
      )
  }

  """
  Every declaration should carry the file and line it was written at.

  The engine hangs a `@sourceMap` directive off a field it was given one for,
  so an error about a function can point at the source instead of at a name.
  What the macro reads is `proc_macro::Span`, whose `file()` is relative to the
  crate root — `src/main.rs` for a module's own source, which is what the engine
  wants — and whose `line()` and `column()` are one-indexed like the engine's.

  The line number itself is not asserted: it moves whenever the fixture is
  edited, and a check that has to be updated with every unrelated edit is a
  check that gets updated without being read. The filename reaching the
  directive at all is what fails when the macro stops attaching source maps.
  """
  pub declarationsCarrySourceMaps(ws: Workspace!): Void @check {
    let declared = harness.target(ws).query(
      "{__type(name:\"FeatureMatrix\"){fields{name directives{name args{name value}}}}}",
    )

    declared.assertStdoutContains(
      "sourceMap",
      "a function should be registered with a source map",
    )
    declared.assertStdoutContains(
      "src/main.rs",
      "the source map should name the file the function was written in",
    )
  }
}
