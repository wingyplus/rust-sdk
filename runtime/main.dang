let modSourceDirPath = "/src"
let genDir = "dagger_sdk"
let entrypointPath = "/usr/local/bin/dagger-module"
let cargoTargetDir = "/build-target"

# Cargo splits its download cache in two, and goish lands in the second one:
# crates.io tarballs go under $CARGO_HOME/registry, git dependencies under
# $CARGO_HOME/git. Caching only the registry would re-clone goish on every
# module build. $CARGO_HOME is /usr/local/cargo in the official rust images.
let cargoRegistryDir = "/usr/local/cargo/registry"
let cargoGitDir = "/usr/local/cargo/git"

# Build image. Kept in step with the same constant in ../mod.dang: bindings are
# generated with this toolchain and compiled with it.
let rustImage = "rust:1.90-bookworm@sha256:3914072ca0c3b8aad871db9169a651ccfce30cf58303e5d6f2db16d1d8a7e58f"

# The target the module binary is linked for. goish is Linux x86_64 only, and
# the module's .cargo/config.toml names the same tuple so proc-macro crates are
# built for the host without the bare-metal link flags.
let cargoTarget = "x86_64-unknown-linux-gnu"

# The platform the finished module binary is served on. goish only targets
# x86_64, so this is always linux/amd64 no matter what the engine runs: an
# x86_64 binary cannot be exec'd as the entrypoint of an arm64 container. The
# *build* is a different question — see crossToolchainSetup, which lets it
# follow the engine. Kept in step with the same constant in ../mod.dang.
let servePlatform: Platform! = "linux/amd64"

# Cargo's per-target linker override for cargoTarget, set by environment rather
# than in .cargo/config.toml on purpose: every module commits that file, and it
# must keep working byte-for-byte unchanged. Debian calls the native driver
# x86_64-linux-gnu-gcc on an amd64 host and installs the cross driver under the
# same name elsewhere, so one value covers both cases.
let crossLinkerEnv = "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER"
let crossLinker = "x86_64-linux-gnu-gcc"

# Install the x86_64 cross driver unless the build host is already x86_64.
# rustc needs no help cross-compiling once `rustup target add` has run — the
# goish sources compile clean for x86_64 on an arm64 host. Only the link step
# breaks: rustc shells out to `cc` with -m64, and the stock arm64 driver rejects
# it ("unrecognized command-line option '-m64'").
let crossToolchainSetup = "test \"$(uname -m)\" = x86_64 || { apt-get update -qq && apt-get install -y -qq --no-install-recommends gcc-x86-64-linux-gnu; }"

# Cache volumes holding compiled objects are keyed by build host. Cargo puts
# target artifacts under $CARGO_TARGET_DIR/<target>/ but host artifacts — build
# scripts and proc-macro .so files — directly under $CARGO_TARGET_DIR/release/.
# Those are architecture-specific, so an amd64 and an arm64 engine must not
# share one volume. The registry and git caches hold source, not objects, and
# stay shared.
let buildHostKey: String! {
  if (defaultPlatform == "linux/amd64") {
    "linux-amd64"
  } else {
    if (defaultPlatform == "linux/arm64") { "linux-arm64" } else { "other" }
  }
}

"""
Runtime module for the Rust SDK.

Builds and packages a module from its already-vendored, committed sources. Code
generation is owned by the Rust SDK's `generate` step (`dagger generate`), not
here: modules commit their generated `dagger_sdk/` directory, so the engine skips
codegen at module load and this runtime only fetches dependencies, compiles, and
sets the entrypoint.
"""
type RustSdkRuntime {
  """
  No-op: code generation is owned by `dagger generate`. Modules commit the
  generated files, so the engine skips codegen at module load. Returning the
  module source unchanged keeps the SDK code-generator contract satisfied without
  generating anything.
  """
  pub codegen(
    modSource: ModuleSource!,
    introspectionJson: File,
  ): GeneratedCode! {
    generatedCode(code: modSource.contextDirectory)
  }

  """
  Compile the module from its committed sources and return a container that runs
  it. The module is self-contained — the Rust SDK is vendored under `dagger_sdk/`
  and `Cargo.toml` depends on it by path — so `cargo build` only fetches
  third-party crates. No codegen, introspection, or scaffolding happens here.

  The build products are copied out of the cache mounts into the image, so the
  returned container runs a single statically linked binary with no cargo
  registry or target directory attached.
  """
  pub moduleRuntime(
    modSource: ModuleSource!,
    introspectionJson: File,
  ): Container! {
    # moduleOriginalName, not moduleName: the latter reflects any alias the
    # module was installed under as a dependency, while the cargo [package] name
    # was written from the module's own name at init time. Core's built-in Go
    # runtime uses ModuleOriginalName for the same reason.
    let modName = modSource.moduleOriginalName
    let subPath = modSource.sourceSubpath
    let contextDir = modSource.contextDirectory

    let workdir = Path(modSourceDirPath).join(Path(subPath)).string
    let binPath = Path(cargoTargetDir)
      .join(Path(cargoTarget))
      .join(Path("release"))
      .join(Path(toRustCrateName(modName)))
      .string

    # The build container follows the engine's own platform, so rustc runs
    # natively and cross-links to cargoTarget. On an arm64 engine that replaces
    # a fully emulated cargo build with a native one; only the finished binary
    # is left to run under emulation.
    let builder = baseContainer(container())
      .withMountedDirectory(modSourceDirPath, contextDir)
      .withWorkdir(workdir)
      .withEnvVariable("CARGO_TARGET_DIR", cargoTargetDir)
      # The goish git dependency is fetched over https; cargo's built-in git
      # client is enough, but the CLI transport gives usable errors on failure.
      .withEnvVariable("CARGO_NET_GIT_FETCH_WITH_CLI", "true")
      .withExec(["sh", "-c", missingSdkGuard(subPath)])
      .withExec(["cargo", "build", "--release"])
      .withExec(["cp", binPath, entrypointPath])

    # Serve on servePlatform, because the binary is x86_64 whatever built it.
    # goish links it statically with no libc and no dynamic loader, so the image
    # needs nothing else at all — not even the toolchain that produced it. That
    # also keeps an arm64 engine from having to pull the amd64 `rust` image.
    container(platform: servePlatform)
      .withFile(entrypointPath, builder.file(entrypointPath), permissions: 493)
      .withEntrypoint([entrypointPath])
  }

  """
  A shell guard that fails the build, actionably, when the module is missing its
  vendored SDK — e.g. `dagger generate` was never run, or its output was not
  committed. Without it, `cargo build` fails on the unresolvable
  `dagger-sdk = { path = "./dagger_sdk" }` dependency with an error that says
  nothing about `dagger generate`.

  This runs *inside* the container rather than as a dang-side check on the
  context directory, and that placement is the point. `moduleRuntime` is
  evaluated whenever the engine merely enumerates a workspace's modules — to
  discover generators, for instance — long before anything is built. Raising
  there makes an ungenerated module impossible to even look at, which breaks
  `dagger generate` on a freshly cloned repository: generation cannot run
  because the modules it would generate cannot be loaded. Deferring the check to
  an exec keeps the container lazy, so the failure surfaces only when the module
  is actually built.
  """
  let missingSdkGuard(subPath: String!): String! {
    let moduleLabel = if (subPath == "" or subPath == ".") { "." } else { subPath }
    # Single-quoted for the shell, so the message must not contain single
    # quotes — `dagger generate` is spelled with backticks for that reason.
    let message = "the Rust module at " + moduleLabel + " is missing its generated directory " + genDir + " (missing or empty): run `dagger generate` and commit the generated files"
    "test -s " + genDir + "/Cargo.toml || { echo '" + message + "' >&2; exit 1; }"
  }

  let baseContainer(ctr: Container!): Container! {
    ctr
      .from(rustImage)
      .withoutEntrypoint
      .withExec(["rustup", "target", "add", cargoTarget])
      .withExec(["sh", "-c", crossToolchainSetup])
      .withEnvVariable(crossLinkerEnv, crossLinker)
      .withMountedCache(cargoRegistryDir, cacheVolume("rust-sdk-cargo-registry"))
      .withMountedCache(cargoGitDir, cacheVolume("rust-sdk-cargo-git"))
      .withMountedCache(cargoTargetDir, cacheVolume("rust-sdk-module-target-" + buildHostKey))
  }
}

"""
Convert a Dagger module name into a Rust crate name ("my-module" ->
"my_module").

Kept byte-for-byte in step with rustCrateName in
helpers/render-template/main.go, which derives the same name at init time: that
one names the `[package]` cargo builds, this one names the binary cargo emits.
A divergence means the entrypoint points at a path that does not exist.
"""
let toRustCrateName(name: String!): String! {
  name
    # The braces are load-bearing. replaceMatches is Go's
    # regexp.ReplaceAllString, which reads `$1_` as a reference to a group
    # *named* "1_" — so "$1_$2" silently expands to nothing plus group 2 and
    # "HTTPServer" becomes "server". See TestDangCrateNameMatchesGo.
    .replaceMatches(`([A-Z]+)([A-Z][a-z])`, with: "${1}_${2}")
    .replaceMatches(`([a-z0-9])([A-Z])`, with: "${1}_${2}")
    .replaceMatches(`[^A-Za-z0-9]+`, with: "_")
    .trim("_")
    .toLower
}
